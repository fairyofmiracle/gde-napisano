# Скопируйте в .env и поправьте под себя. Файл .env в git не попадает.

# --- Доступ ---
# Пустой токен = админка, загрузка документов и операторская ЗАКРЫТЫ.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=
# Токен короче этого числа символов не принимается (админка остаётся закрытой)
ADMIN_TOKEN_MIN_LENGTH=16
# С каких адресов пускать в админку: адреса и сети через запятую (10.0.0.0/8, 203.0.113.7). Пусто = с любых.
ADMIN_ALLOWED_IPS=
# После стольких неверных токенов подряд адрес блокируется; каждая следующая блокировка вдвое длиннее
ADMIN_MAX_FAILURES=5
ADMIN_LOCKOUT_SECONDS=300
# Запросов к админке в минуту с одного адреса
ADMIN_RATE_LIMIT_PER_MINUTE=60

# --- Публичный стенд (docker compose: Caddy впереди приложения) ---
# 127.0.0.1 = стенд виден только с самого сервера. На сервере для доступа извне: PUBLIC_BIND=0.0.0.0
PUBLIC_BIND=127.0.0.1
# Домен (docs.example.ru или 203-0-113-7.sslip.io) = HTTPS с сертификатом Let's Encrypt.
# Пусто = обычный HTTP на порту 80, без шифрования (только для проверки).
SITE_ADDRESS=
HTTP_PORT=80
HTTPS_PORT=443

# --- LLM: gigachat | ollama ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_NUM_CTX=8192
# Для GigaChat: ключ авторизации из личного кабинета и корневой сертификат НУЦ Минцифры
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# Пусто = искать certs/russian_trusted_root_ca.pem (в Docker /certs/...), см. certs/README.md
GIGACHAT_CA_BUNDLE=
# Повторы при 429/5xx/обрыве связи, пауза перед первым повтором (дальше вдвое), одновременных запросов к модели
LLM_RETRIES=2
LLM_RETRY_BACKOFF=1.0
LLM_MAX_CONCURRENCY=2

# --- Хранилище ---
# Без Docker: локальная папка Qdrant (сервер не нужен). В Docker задаётся QDRANT_URL.
QDRANT_PATH=./data/runtime/qdrant
QDRANT_URL=
DATA_DIR=./data/runtime
DOCS_DIR=./data/runtime/docs
# Скопируйте examples/boxes.csv → data/boxes.csv и поправьте под себя (папка data/ в git не попадает)
BOXES_CSV=./data/boxes.csv
# Redis необязателен (только ограничение частоты запросов)
REDIS_URL=

# --- Модели поиска ---
EMBED_MODEL=intfloat/multilingual-e5-base
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Папка кэша моделей (по умолчанию ~/.cache/huggingface)
# HF_HOME=
# После scripts/prefetch_models.sh можно запретить скачивание при старте:
# HF_HUB_OFFLINE=1
# Прогреть модели при старте (/ready отвечает 503, пока не прогреты)
WARMUP_ON_START=true

# --- Пороги (оценка реранкера 0..1) ---
CONFIDENT_THRESHOLD=0.50
UNCERTAIN_THRESHOLD=0.03
BOX_FALLBACK_THRESHOLD=0.5
FEEDBACK_SAMPLE_RATE=0.02
# Если два лучших пункта из разных документов ближе этой разницы, к ответу добавляется предупреждение
AMBIGUITY_MARGIN=0.05

# --- Ход работы ---
# Переформулировать вопрос и искать повторно, если первый поиск неуверенный (не больше AGENT_MAX_REWRITES раз, 0..2)
AGENT_REWRITE=true
AGENT_MAX_REWRITES=1
# Переформулировать с помощью модели (false = только правила: синонимы, разбиение на части)
AGENT_REWRITE_USE_LLM=true
# Сверять числа и даты в ответе с текстом пункта
CHECK_NUMBERS=true

# --- Память отзывов и практика ---
# Насколько отзывы могут поднять оценку пункта (0..1)
MEMORY_MAX_BOOST=0.15
# Кейсы «как решили на практике» видны только после одобрения в операторской
PRACTICE_REQUIRES_APPROVAL=true

# --- OCR ---
OCR_LANG=rus+eng
# Windows без Docker: путь к tesseract.exe, если его нет в PATH
TESSERACT_CMD=
# Для .doc нужен LibreOffice: путь к soffice, если его нет в PATH
SOFFICE_CMD=soffice

# Режим для работы с интерфейсом без моделей (ответы-заглушки)
DEMO_UI_ONLY=false

# --- Загрузка, частота запросов, CORS ---
# Максимальный размер файла в мегабайтах
MAX_UPLOAD_MB=50
# Допустимые расширения через запятую. Пусто = все форматы, которые умеет разбирать приложение.
ALLOWED_UPLOAD_EXTENSIONS=
# Вопросов в минуту с одного адреса (0 = без ограничения). Счётчик в памяти процесса, либо в Redis при заданном REDIS_URL.
RATE_LIMIT_PER_MINUTE=30
# Отдельные лимиты с одного адреса: отзывы, практика, загрузка документов
FEEDBACK_RATE_LIMIT_PER_MINUTE=20
PRACTICE_RATE_LIMIT_PER_MINUTE=5
UPLOAD_RATE_LIMIT_PER_MINUTE=10
# Адреса доверенных клиентов (Telegram-бот в compose) со своим лимитом: бот ходит с одного адреса за всех пользователей
TRUSTED_CLIENT_IPS=
RATE_LIMIT_TRUSTED_PER_MINUTE=300
# Источники для браузерных клиентов через запятую. Пусто — только тот же сайт, * — любой источник.
CORS_ORIGINS=

# --- Фильтр нецензурной лексики ---
# on — вопросы с русским и английским матом не уходят в поиск и модель, пользователь получает вежливый отказ
# (тот же фильтр действует на текст «как решили на практике»). off — отключить.
PROFANITY_FILTER=on
# Слова-исключения через запятую, если фильтр ошибочно режет нужное слово из ваших документов
PROFANITY_ALLOWLIST=

# --- Telegram-бот (docker compose --profile bot up -d --build, либо python -m bot) ---
# Токен от @BotFather. Пусто = бот не запускается. В чат и в git токен не отправляйте.
TELEGRAM_BOT_TOKEN=
# Telegram id через запятую, кому разрешено писать боту. Пусто = всем.
TELEGRAM_ALLOWED_USERS=
# Группы и каналы бот игнорирует. Чтобы разрешить группу, укажите её id через запятую.
TELEGRAM_ALLOWED_CHATS=
# Где работает приложение (в Docker compose подставляется http://app:8000)
DOCAGENT_URL=http://localhost:8010
# Вопросов в минуту от одного пользователя. По умолчанию берётся RATE_LIMIT_PER_MINUTE
# BOT_RATE_LIMIT_PER_MINUTE=30

# Распознавание голосовых: gigaam | whisper | off
TRANSCRIBER=gigaam
# Самое длинное голосовое в секундах (длиннее не обрабатывается)
VOICE_MAX_SECONDS=120
# Голосовых в минуту от одного пользователя и сколько голосовых может ждать распознавания одновременно
VOICE_PER_MINUTE=3
VOICE_QUEUE_MAX=3
# GigaAM: v3_e2e_ctc (с пунктуацией) или v3_ctc. Веса около 450 МБ скачиваются при первом голосовом.
GIGAAM_MODEL=v3_e2e_ctc
# Папка для весов GigaAM (в Docker уже задана)
GIGAAM_DIR=
# whisper: размер модели faster-whisper и точность вычислений (нужен faster-whisper, см. requirements-bot.txt)
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
# Потоков процессора на распознавание
TRANSCRIBER_THREADS=3
# Через сколько секунд без голосовых выгрузить модель из памяти (0 = держать всегда)
TRANSCRIBER_IDLE_SECONDS=600
